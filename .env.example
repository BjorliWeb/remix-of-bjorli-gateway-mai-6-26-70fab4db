# ---------------------------------------------------------------------------
# Bjorli — environment variable placeholders
# ---------------------------------------------------------------------------
# This file is the canonical reference for env vars used by the FUTURE
# Next.js production frontend (see docs/PRODUCTION_HANDOFF.md).
#
# The current Lovable prototype only uses the VITE_SUPABASE_* values that
# are auto-injected by Lovable Cloud. Everything else below is a placeholder
# for the production handoff — DO NOT put real secrets in this file.
# ---------------------------------------------------------------------------

# --- Site ------------------------------------------------------------------
PUBLIC_SITE_URL=https://bjorli.no
NEXT_PUBLIC_SITE_URL=https://bjorli.no

# --- WordPress (CMS, not yet connected) ------------------------------------
WORDPRESS_API_URL=https://cms.bjorli.no/wp-json/wp/v2
# Optional — only if WPGraphQL is installed
WORDPRESS_GRAPHQL_URL=https://cms.bjorli.no/graphql
# Optional — required for Next.js Draft/Preview Mode
WORDPRESS_PREVIEW_SECRET=

# --- Fnugg (public API, no secret) -----------------------------------------
FNUGG_RESORT_ID=177
FNUGG_RESORT_API_URL=https://api.fnugg.no/get/resort/177
# Blog/driftsmelding search — see src/lib/integrations/fnugg.ts for params
FNUGG_BLOG_API_URL=https://api.fnugg.no/search

# --- Feature flags ---------------------------------------------------------
# When false, hides the "translation pending" notice on locales without
# CMS-translated bodies. Set to true on staging for translator QA.
SHOW_TRANSLATION_PLACEHOLDERS=false

# --- Analytics & verification (optional) -----------------------------------
ANALYTICS_ID=
SEARCH_CONSOLE_VERIFICATION=

# --- Vite (Lovable prototype) analytics + verification --------------------
# When set, src/lib/analytics.ts loads gtag.js and emits page_view + events.
# Prefer GTM if you want a single tag manager; otherwise set GA4 directly.
# Use the GA4 "Measurement ID" (format: G-XXXXXXXXXX), not the legacy UA ID.
# IMPORTANT: do NOT set a production GA4 ID in preview/staging environments
# unless you explicitly want preview traffic in the same property. The
# Lovable preview is intentionally noindex, but analytics WILL still fire if
# this variable is set. See docs/SEO_ANALYTICS_SETUP.md for the full flow.
VITE_GA4_MEASUREMENT_ID=
VITE_GTM_ID=
# Google Search Console verification token (the value of the `content`
# attribute on the meta tag Search Console gives you, WITHOUT the leading
# `google-site-verification=` prefix). Injected by SEOHead when set.
# Configure only in production. See docs/SEO_ANALYTICS_SETUP.md.
VITE_GOOGLE_SITE_VERIFICATION=

# --- Google Tag Manager + GA4 (production, not yet active) -----------------
# Production loads GTM once in app/layout.tsx via next/script
# (strategy="afterInteractive"). GA4 is configured as a tag INSIDE GTM —
# do not also load gtag.js. Leave blank in the prototype; the analytics
# helper in src/lib/analytics.ts is a no-op until these are set.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
